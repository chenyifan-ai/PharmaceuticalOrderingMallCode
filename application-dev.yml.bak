server:
  port: 8080
  servlet:
    context-path: /

spring:
  application:
    name: pharmacy-mall

  # MySQL 数据库配置（生产环境）
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/pharmacy_mall?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: root

  # SQL初始化
  sql:
    init:
      mode: always
      schema-locations: classpath:db/schema-mysql.sql
      encoding: utf-8
      continue-on-error: false

  # Redis配置（开发环境禁用）
  redis:
    host: localhost
    port: 6379
    password:
    database: 0

  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

# MyBatis Plus配置
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.yao.pharmacymall.entity
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT配置
jwt:
  secret: pharmacy-mall-secret-key-2026-yao
  expiration: 86400000
  header: Authorization
  prefix: Bearer

# 日志配置
logging:
  level:
    com.yao.pharmacymall: debug
    org.springframework.security: warn
