server:
  port: 8080
  servlet:
    context-path: /

spring:
  application:
    name: pharmacy-mall
  profiles:
    active: dev

  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 50MB

# MyBatis Plus配置
mybatis-plus:
  mapper-locations: classpath*:/mapper/**/*.xml
  type-aliases-package: com.yao.pharmacymall.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl
  global-config:
    db-config:
      id-type: auto
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

# JWT配置
jwt:
  secret: pharmacy-mall-secret-key-2026-yao
  expiration: 86400000  # 24小时
  header: Authorization
  prefix: Bearer

# 日志配置
logging:
  level:
    com.yao.pharmacymall: debug
  pattern:
    console: '%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{50} - %msg%n'

# 业务配置
business:
  prescription:
    audit-timeout: 7200  # 处方审核超时时间(秒) 2小时
  order:
    cancel-timeout: 1800  # 订单取消超时时间(秒) 30分钟
